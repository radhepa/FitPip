# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Set to "true" to show "Suggest a workout" (needs the suggest-workout Edge Function
# and an OpenRouter key; see the README). Off by default.
# VITE_ENABLE_SUGGEST=true
