# Secrets for the Edge Functions. Never commit real values.
# Set them on your project with:   npx supabase secrets set --env-file supabase/functions/.env
# (or one at a time in the dashboard: Edge Functions -> Secrets)

# Required: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which model to ask. Defaults to openai/gpt-4o-mini. Any OpenRouter model id works,
# e.g. google/gemini-2.5-flash. See https://openrouter.ai/models
# OPENROUTER_MODEL=openai/gpt-4o-mini
